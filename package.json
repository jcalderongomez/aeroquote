{
  "name": "aeroquote",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "front",
    "back"
  ],
  "scripts": {
    "dev:front": "npm run dev --workspace @aeroquote/front",
    "dev:back": "npm run dev --workspace @aeroquote/back",
    "build": "npm run db:generate && npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspace @aeroquote/back",
    "db:generate": "npm run db:generate --workspace @aeroquote/back",
    "db:migrate": "npm run db:migrate --workspace @aeroquote/back",
    "db:deploy": "npm run db:deploy --workspace @aeroquote/back",
    "db:seed": "npm run db:seed --workspace @aeroquote/back",
    "db:seed-services": "npm run db:seed-services --workspace @aeroquote/back"
  }
}
